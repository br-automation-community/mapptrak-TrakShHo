(*ERROR IDs*)
VAR CONSTANT
	tshERR_NO_ASM_REF : DINT := -536164451; (*No Assembly reference is assigned to the function block*)
	tshERR_NO_SEC_REF : DINT := -536164450; (*No Sector reference is assigned to the function block*)
	tshERR_NO_PP_REF : DINT := -536164449; (*No Process point reference is assigned to the function block*)
	tshERR_NO_BUFFER_REF : DINT := -536164351; (*No communication buffer reference is assigned to the function block*)
	tshERR_BUFFER_WRONG_SIZE : DINT := -536164350; (*The communication buffer has the wrong size *)
	tshERR_WRONG_USERDATA_SIZE : DINT := -536164349; (*The size of the userdata is not matching with the size of the communication buffer *)
	tshERR_NO_PARAMETER_REF : DINT := -536164251; (*No Parameter reference is assigned to the function block*)
	tshERR_PARAMETER_VALUE : DINT := -536164250; (*A Parameter has a wrong value*)
	tshERR_NO_CONFIG_REF : DINT := -536164151; (*No Configuration reference is assigned to the function block*)
	tshERR_CONFIG_VALUE : DINT := -536164150; (*A Configuration parameter has a wrong value*)
	tshERR_COMMUNICATION_TIMEOUT : DINT := -536163451; (*The communication between the assemblies timed out*)
	tshERR_SHUTTLE_ERROR_STOP : DINT := -536163351; (*A shuttle had an errorstop in the handover zone *)
	tshERR_SHUTTLE_POSITIONING : DINT := -536163350; (*Moving a shuttle to a position for the handover procedure failed*)
	tshERR_HANDOVER : DINT := -536162451; (*An error happened during the handover*)
	tshERR_NO_RESPONSE : DINT := -536163450; (*There is no response of Assembly 2 while the handover procedure *)
	tshERR_RECOVERY : DINT := -536161451; (*An error happened during the recovery*)
	tshERR_INTERNAL : DINT := -536165552; (*Internal error *)
	tshWRN_USERDATA : DINT := -1609907275; (*The userdata size is 0. Therefore no userdata is transferred to the other assembly*)
	tshWRN_HANDOVER_SHUTTLE_STOP : DINT := -1609906175; (*During the handover, the shuttle went to error stop but the procedure continued*)
	tshWRN_HANDOVER_STOP : DINT := -1609906275; (*No handover possible due to a problem on the other assembly*)
	tshWRN_SIMULATION : DINT := -1609898275; (*Warnings entered by the simulation mode*)
	tshWRN_RECOVERY_BLOCKED : DINT := -1609898075; (*Warning entered, that the recovery is blocked*)
	tshWRN_INTERNAL : DINT := -1609907376; (*Internal warning*)
	tshSCS_HANDOVER_RESTART : DINT := 537576473; (*The handover was restartet successfully *)
	tshSCS_HANDOVER_INIT : DINT := 537576373; (*The handover was initialized successfully *)
	tshINFO_HANDOVER_LENGHT : DINT := 1611318198; (*Information, how long the overlapping area is located*)
	tshINFO_HANDOVER_REFERENCE_POINT : DINT := 1611318197; (*Information, where the handover point is located*)
	tshINFO_INTERNAL : DINT := 1611318096; (*Internal information*)
END_VAR
